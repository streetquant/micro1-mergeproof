{
  "$defs": {
    "Verdict": {
      "enum": [
        "approve",
        "reject",
        "human_review"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "build_worktree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Build Worktree Sha256",
      "type": "string"
    },
    "bundle": {
      "title": "Bundle",
      "type": "string"
    },
    "bundle_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Manifest Sha256",
      "type": "string"
    },
    "bundle_verified": {
      "const": true,
      "title": "Bundle Verified",
      "type": "boolean"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "certificate": {
      "title": "Certificate",
      "type": "string"
    },
    "certificate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Certificate Sha256",
      "type": "string"
    },
    "consequential_action_taken": {
      "const": false,
      "title": "Consequential Action Taken",
      "type": "boolean"
    },
    "context": {
      "title": "Context",
      "type": "string"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        10,
        20
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "failed_check_ids": {
      "items": {
        "type": "string"
      },
      "title": "Failed Check Ids",
      "type": "array"
    },
    "failed_checks": {
      "minimum": 0,
      "title": "Failed Checks",
      "type": "integer"
    },
    "human_approval_required": {
      "const": true,
      "title": "Human Approval Required",
      "type": "boolean"
    },
    "human_report": {
      "title": "Human Report",
      "type": "string"
    },
    "human_report_markdown": {
      "title": "Human Report Markdown",
      "type": "string"
    },
    "inconclusive_check_ids": {
      "items": {
        "type": "string"
      },
      "title": "Inconclusive Check Ids",
      "type": "array"
    },
    "inconclusive_checks": {
      "minimum": 0,
      "title": "Inconclusive Checks",
      "type": "integer"
    },
    "manifest": {
      "title": "Manifest",
      "type": "string"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "project_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Sha256",
      "type": "string"
    },
    "protocol": {
      "const": "driftproof.agent.v1",
      "default": "driftproof.agent.v1",
      "title": "Protocol",
      "type": "string"
    },
    "recommended_action": {
      "enum": [
        "human_approval",
        "repair_required",
        "evidence_or_human_escalation"
      ],
      "title": "Recommended Action",
      "type": "string"
    },
    "report": {
      "title": "Report",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "response_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response File"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "const": "valid_review",
      "default": "valid_review",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "tool_version": {
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "verify_argv": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "title": "Verify Argv",
      "type": "array"
    }
  },
  "required": [
    "tool_version",
    "request_sha256",
    "candidate_id",
    "verdict",
    "exit_code",
    "recommended_action",
    "summary",
    "project",
    "context",
    "project_sha256",
    "context_sha256",
    "build_worktree_sha256",
    "bundle",
    "report",
    "certificate",
    "manifest",
    "human_report",
    "human_report_markdown",
    "certificate_sha256",
    "bundle_manifest_sha256",
    "bundle_verified",
    "failed_checks",
    "inconclusive_checks",
    "failed_check_ids",
    "inconclusive_check_ids",
    "verify_argv",
    "human_approval_required",
    "consequential_action_taken"
  ],
  "title": "DriftProofNavigationResponse",
  "type": "object"
}
