{
  "$defs": {
    "DriftProofReviewRequest": {
      "additionalProperties": false,
      "description": "Versioned declarative input for one dbt review.",
      "properties": {
        "agent_model": {
          "default": "openai/gpt-oss-20b",
          "title": "Agent Model",
          "type": "string"
        },
        "agent_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Provider"
        },
        "agent_record_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Record Dir"
        },
        "agent_replay_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Replay Dir"
        },
        "allow_external_provider": {
          "default": false,
          "title": "Allow External Provider",
          "type": "boolean"
        },
        "allow_unconfined": {
          "default": false,
          "title": "Allow Unconfined",
          "type": "boolean"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "isolation": {
          "default": "auto",
          "enum": [
            "auto",
            "disposable_copy",
            "bubblewrap"
          ],
          "title": "Isolation",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "project": {
          "minLength": 1,
          "title": "Project",
          "type": "string"
        },
        "protocol": {
          "const": "driftproof.request.v1",
          "default": "driftproof.request.v1",
          "title": "Protocol",
          "type": "string"
        },
        "replace_output": {
          "default": false,
          "title": "Replace Output",
          "type": "boolean"
        },
        "response_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response File"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 120,
          "maximum": 900,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "work_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Root"
        }
      },
      "required": [
        "project"
      ],
      "title": "DriftProofReviewRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_argv": {
      "items": {
        "type": "string"
      },
      "title": "Agent Argv",
      "type": "array"
    },
    "candidate_code_executed": {
      "const": false,
      "default": false,
      "title": "Candidate Code Executed",
      "type": "boolean"
    },
    "configuration_request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Request Sha256",
      "type": "string"
    },
    "consequential_action_taken": {
      "const": false,
      "default": false,
      "title": "Consequential Action Taken",
      "type": "boolean"
    },
    "content_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Fingerprint Sha256",
      "type": "string"
    },
    "context": {
      "title": "Context",
      "type": "string"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "external_provider_response_bound": {
      "const": false,
      "default": false,
      "title": "External Provider Response Bound",
      "type": "boolean"
    },
    "fingerprint_scope": {
      "const": "candidate_context_and_review_configuration",
      "default": "candidate_context_and_review_configuration",
      "title": "Fingerprint Scope",
      "type": "string"
    },
    "human_approval_required": {
      "const": true,
      "default": true,
      "title": "Human Approval Required",
      "type": "boolean"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "project_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Sha256",
      "type": "string"
    },
    "protocol": {
      "const": "driftproof.fingerprint.v1",
      "default": "driftproof.fingerprint.v1",
      "title": "Protocol",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/DriftProofReviewRequest"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tool_version": {
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "tool_version",
    "configuration_request_sha256",
    "content_fingerprint_sha256",
    "project",
    "context",
    "project_sha256",
    "context_sha256",
    "request"
  ],
  "title": "DriftProofFingerprintResponse",
  "type": "object"
}
