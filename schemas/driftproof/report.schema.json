{
  "$defs": {
    "AgentTrace": {
      "additionalProperties": false,
      "properties": {
        "accepted_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Rule Ids",
          "type": "array"
        },
        "agent": {
          "const": "contract_clarifier",
          "default": "contract_clarifier",
          "title": "Agent",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_sha256": {
          "default": "",
          "title": "Output Sha256",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "rejected_proposals": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Proposals",
          "type": "array"
        },
        "request_hash": {
          "title": "Request Hash",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "unresolved_sentences": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Sentences",
          "type": "array"
        }
      },
      "required": [
        "provider",
        "model",
        "request_hash"
      ],
      "title": "AgentTrace",
      "type": "object"
    },
    "BuildResult": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "isolation": {
          "enum": [
            "disposable_copy",
            "bubblewrap"
          ],
          "title": "Isolation",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "returncode": {
          "title": "Returncode",
          "type": "integer"
        },
        "stderr": {
          "title": "Stderr",
          "type": "string"
        },
        "stdout": {
          "title": "Stdout",
          "type": "string"
        },
        "worktree_sha256": {
          "title": "Worktree Sha256",
          "type": "string"
        }
      },
      "required": [
        "command",
        "returncode",
        "passed",
        "stdout",
        "stderr",
        "duration_ms",
        "isolation",
        "worktree_sha256"
      ],
      "title": "BuildResult",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "title",
        "detail"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "ContractRule": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RuleKind"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "source_text"
      ],
      "title": "ContractRule",
      "type": "object"
    },
    "ContractSpec": {
      "additionalProperties": false,
      "properties": {
        "context_sha256": {
          "title": "Context Sha256",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ContractRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "unknown_sentences": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Sentences",
          "type": "array"
        }
      },
      "required": [
        "context_sha256",
        "rules"
      ],
      "title": "ContractSpec",
      "type": "object"
    },
    "RuleKind": {
      "enum": [
        "public_contract",
        "source_alias",
        "derived_concat",
        "numeric_null_policy",
        "dependency_exists",
        "preserve_field",
        "latest_record",
        "required_identifier",
        "categorical_mapping",
        "macro_keyword",
        "timezone_date",
        "subtraction_formula"
      ],
      "title": "RuleKind",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "approve",
        "reject",
        "human_review"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "build": {
      "$ref": "#/$defs/BuildResult"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "certificate_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Certificate Sha256"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "consequential_action_taken": {
      "const": false,
      "default": false,
      "title": "Consequential Action Taken",
      "type": "boolean"
    },
    "context_sha256": {
      "title": "Context Sha256",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/ContractSpec"
    },
    "failed_check_ids": {
      "items": {
        "type": "string"
      },
      "title": "Failed Check Ids",
      "type": "array"
    },
    "human_approval_required": {
      "const": true,
      "default": true,
      "title": "Human Approval Required",
      "type": "boolean"
    },
    "inconclusive_check_ids": {
      "items": {
        "type": "string"
      },
      "title": "Inconclusive Check Ids",
      "type": "array"
    },
    "project_sha256": {
      "title": "Project Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "trajectory_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trajectory Sha256"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "candidate_id",
    "verdict",
    "summary",
    "project_sha256",
    "context_sha256",
    "build",
    "contract",
    "checks"
  ],
  "title": "GateReport",
  "type": "object"
}
